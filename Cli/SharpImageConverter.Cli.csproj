<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SharpImageConverter.Cli</AssemblyName>
    <RootNamespace>SharpImageConverter</RootNamespace>
    <Description>SharpImageConverter CLI entry.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\\src\\SharpImageConverter.csproj" />
  </ItemGroup>
  <!-- 原生 WebP 库由 src 项目按 RID（未指定 RID 时按宿主 OS）拷贝到输出根目录，
       见 src/SharpImageConverter.csproj 的 _SicNativeRid。此处不再重复拷贝 runtimes/**，
       否则会把其他平台的原生库塞进发布目录。 -->
</Project>
